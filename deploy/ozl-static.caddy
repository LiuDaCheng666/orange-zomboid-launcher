encode gzip zstd
header {
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
	X-Frame-Options DENY
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
}
@pages not path /assets/* /releases/* /release.json /updates/latest/* /updates/velopack/*
header @pages Cache-Control no-cache
@assets path /assets/*
header @assets Cache-Control "public, max-age=86400"
@metadata path /release.json /updates/latest/* /updates/velopack/*
header @metadata Cache-Control "no-cache, no-store, must-revalidate"
handle /releases/* {
	root * /var/www/ozl
	header Cache-Control "public, max-age=31536000, immutable"
	header Content-Disposition attachment
	file_server
}
handle {
	root * /var/www/ozl/current
	file_server
}
log {
	output file /var/log/caddy/ozl-access.log {
		roll_size 10MiB
		roll_keep 5
		roll_keep_for 168h
	}
}
